# --- 판단 엔진: auto(기본) | api | cli | codex | off ---
# auto는 API → Claude CLI → Codex CLI 순서이며 Claude 한도가 끝나면 Codex로 넘어간다.
ANTHROPIC_API_KEY=
AI_TRADER_BRAIN=auto
AI_TRADER_MODEL=claude-opus-5
AI_TRADER_RESEARCH_MODEL=claude-opus-5
AI_TRADER_CODEX_MODEL=
AI_TRADER_BRAIN_TIMEOUT=240

# --- 토스증권 OpenAPI (없으면 synthetic 시장으로 돈다) ---
# 토스증권 WTS > 설정 > Open API 에서 발급. 허용 IP 등록도 필요하다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT=

# --- DART 전자공시 (국내 종목 상세실적) ---
DART_API_KEY=

# --- 키움증권 REST (국내 주문) ---
KIWOOM_MODE=demo
APP_KEY_MOCK=
APP_SECRET_MOCK=
APP_KEY=
APP_SECRET=

# --- 돈의 경계 (사람이 정하는 유일한 값들) ---
AI_TRADER_START_CASH=10000000
AI_TRADER_USD_KRW=1400
AI_TRADER_UNIVERSE=005930,000660,373220,207940,005380,035420,035720,068270,105560,051910,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY,QQQ,SPYM
AI_TRADER_MAX_POSITION_PCT=0.20
AI_TRADER_DAILY_LOSS_KILL=0.07
AI_TRADER_MAX_ORDERS=8
AI_TRADER_CYCLE_SECONDS=900

# 실주문 스위치. 이 값이 1 이 아니면 토스로 주문이 나가지 않는다.
# 키움 demo 주문은 모의투자라 이 값과 무관하다.
AI_TRADER_LIVE=0

MLFLOW_TRACKING_URI=
